<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si el archivo o directorio solicitado existe físicamente, servirlo tal cual
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Si no existe, enviar toda la petición a index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>