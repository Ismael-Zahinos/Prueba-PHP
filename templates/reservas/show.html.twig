{% extends "base.html.twig" %}

{% block title %}Reserva #{{ reserva.id }} - Detalle{% endblock %}

{% block content %}
    <div style="margin-bottom: 1.5rem;">
        <a href="{{ baseUrl }}/" class="btn btn-secondary">&larr; Volver al Listado</a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
        <!-- Información de la Reserva -->
        <section class="card">
            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1rem;">
                <div>
                    <h2>Reserva #{{ reserva.id }}</h2>
                    <span style="color: var(--text-muted); font-size: 0.85rem;">Creada el {{ reserva.fecha_creacion|date("d/m/Y H:i") }}</span>
                </div>
                <span id="badge-estado-actual" class="badge badge-{{ reserva.estado }}">{{ reserva.estado }}</span>
            </div>

            <div style="display: flex; flex-direction: column; gap: 0.8rem;">
                <div>
                    <strong>Huésped:</strong> {{ reserva.nombre_huesped }}<br>
                    <small style="color: var(--text-muted);">{{ reserva.email_huesped }}</small>
                </div>
                <div>
                    <strong>Alojamiento:</strong> {{ reserva.nombre_alojamiento }}
                </div>
                <div>
                    <strong>Fechas de Estancia:</strong><br>
                    Del {{ reserva.fecha_entrada|date("d/m/Y") }} al {{ reserva.fecha_salida|date("d/m/Y") }}
                </div>
                <div>
                    <strong>Importe Total:</strong> {{ reserva.importe|number_format(2, ',', '.') }} €
                </div>
                {% if reserva.notas %}
                    <div>
                        <strong>Notas:</strong>
                        <p style="background: #f8fafc; border-left: 3px solid var(--border); padding: 0.5rem; margin-top: 0.25rem;">
                            {{ reserva.notas }}
                        </p>
                    </div>
                {% endif %}
            </div>

            <hr style="margin: 1.5rem 0; border: none; border-top: 1px solid var(--border);">

            <!-- Acciones de cambio de estado -->
            <div>
                <h3>Cambiar Estado</h3>
                <div id="acciones-estado" style="display: flex; gap: 0.5rem; margin-top: 0.8rem;">
                    {% if reserva.estado == 'pendiente' %}
                        <button class="btn btn-success btn-accion-estado" data-id="{{ reserva.id }}" data-estado="confirmada">Confirmar Reserva</button>
                        <button class="btn btn-danger btn-accion-estado" data-id="{{ reserva.id }}" data-estado="cancelada">Cancelar Reserva</button>
                    {% elseif reserva.estado == 'confirmada' %}
                        <button class="btn btn-danger btn-accion-estado" data-id="{{ reserva.id }}" data-estado="cancelada">Cancelar Reserva</button>
                    {% else %}
                        <p style="color: var(--text-muted); font-size: 0.9rem;">Esta reserva está cancelada y no permite más cambios.</p>
                    {% endif %}
                </div>
            </div>
        </section>

        <!-- Timeline / Historial de Eventos -->
        <section class="card">
            <h2>Historial de Eventos</h2>
            <div style="margin-top: 1.5rem; position: relative; border-left: 2px solid var(--border); padding-left: 1.5rem; margin-left: 0.5rem;">
                {% for evento in reserva.eventos %}
                    <div style="position: relative; margin-bottom: 1.5rem;">
                        <!-- Punto indicador en la línea de tiempo -->
                        <div style="position: absolute; left: -1.95rem; top: 0.2rem; width: 12px; height: 12px; border-radius: 50%; background: var(--primary); border: 2px solid white;"></div>
                        <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">
                            {{ evento.fecha_creacion|date("d/m/Y H:i:s") }}
                        </div>
                        <div style="font-weight: 700; text-transform: capitalize; margin: 0.2rem 0;">
                            {{ evento.tipo }}
                        </div>
                        <p style="font-size: 0.9rem; color: #334155;">
                            {{ evento.descripcion }}
                        </p>
                    </div>
                {% else %}
                    <p style="color: var(--text-muted);">No hay eventos registrados para esta reserva.</p>
                {% endfor %}
            </div>
        </section>
    </div>
{% endblock %}

{% block javascripts %}
<script>
    const BASE_URL = '{{ baseUrl }}';
</script>
<script src="{{ baseUrl }}/js/app.js"></script>
{% endblock %}