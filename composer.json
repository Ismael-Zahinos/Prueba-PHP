{
    "name": "usuario/prueba-php",
    "description": "API y vistas de reservas de alojamiento en PHP nativo",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.45"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}